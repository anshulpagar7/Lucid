{
  "name": "lucid",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "fetch-models": "node scripts/fetch-model.mjs",
    "test": "vitest run",
    "schema": "node scripts/export-schema.mjs",
    "train": "python3 ml/train.py",
    "train:demo": "python3 ml/train.py --simulate 20 --report ml/reports/demo-synthetic",
    "test:ml": "python3 -m pytest ml/tests -q",
    "fixtures": "python3 ml/make_fixtures.py"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
